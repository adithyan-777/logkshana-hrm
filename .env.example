# Copy to .env and fill in real values. Never commit .env.
DB_NAME=pattika
DB_USER=pattika
DB_PASSWORD=change-me
# Local dev: host Postgres reached from containers via host-gateway.
# DB_HOST is for host-side processes (manage.py, local qcluster).
DB_HOST=localhost
# CONTAINER_DB_HOST is what web/qcluster containers use.
# Precedence in compose: CONTAINER_DB_HOST -> DB_HOST -> host.docker.internal.
# Laptop: set it explicitly (below). Server with RDS: DB_HOST=<endpoint>
# alone is enough; set CONTAINER_DB_HOST too only to override it.
CONTAINER_DB_HOST=host.docker.internal
#   DB_HOST=pattika.xxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432

# TEST DB (docker postgres on 5433): comment the block above and use this.
# Start it with: docker compose --profile test up -d db
#DB_NAME=pattika_test
#DB_USER=pattika
#DB_PASSWORD=pattika-test-pass
#TEST_DB_PASSWORD=pattika-test-pass
#DB_HOST=localhost
#DB_PORT=5433

# q2 Redis broker. Host-side default; compose sets REDIS_HOST=redis
# in web/qcluster containers. Server: point at your ElastiCache endpoint.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

TIME_ZONE=Asia/Qatar

# Device gateway (ZKTeco attendance service)
DEVICE_GATEWAY_BASE_URL=http://gateway:8080
# Shared secret: must match what the gateway is configured with.
# Empty = gateway endpoints accept unauthenticated requests (local dev only).
GATEWAY_SECRET_KEY=change-me
# Realtime push receiver (gateway POSTs each punch here on ingest):
#   POST /api/attendancelog/  (single punch; preferred for realtime forward)
#   POST /attendance/gateway/ (single punch or batch list)
# Configure this URL as PATTIKA_URL in the gateway's .env and set the
# gateway's PATTIKA_TOKEN to this same GATEWAY_SECRET_KEY.
# Example: PATTIKA_URL=https://hr.example.com/api/attendancelog/
# Prerequisites per punch: device serial_number registered in pattika
# (Company device) and employee emp_code == device user_id, else the
# gateway gets HTTP 400 and retries (punch stays recoverable via pull).

# Base domain for tenant subdomains: tenant "demo" is served at
# demo.localhost (no /etc/hosts entry needed for *.localhost).
# In production set this to your real base domain (e.g. pattika.example.com).
BASE_DOMAIN=localhost
DEBUG=False

# Prod HTTPS: set True once https:// works end to end (nginx + certs).
# Keeps session/CSRF cookies off plain HTTP. Local dev stays False.
SECURE_COOKIES=False
