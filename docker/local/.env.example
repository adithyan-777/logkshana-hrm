# Local stack: host Postgres + Docker services (docker/local/docker-compose.yml).
# Copy to docker/local/.env and edit. Never commit docker/local/.env.
#
# Postgres runs on the HOST (your local install on 5432). DB_HOST below is
# for host-side processes (e.g. `python manage.py` on your laptop).
# Containers reach it via CONTAINER_DB_HOST (host-gateway), NOT localhost —
# the compose file resolves DB_HOST as
# CONTAINER_DB_HOST -> DB_HOST -> host.docker.internal.

# Host Postgres credentials (must match your local install).
DB_NAME=pattika
DB_USER=pattika
DB_PASSWORD=change-me
DB_HOST=localhost
# CONTAINER_DB_HOST is what web/qcluster containers use.
CONTAINER_DB_HOST=host.docker.internal
DB_PORT=5432

# q2 Redis broker (compose service `redis`).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Host publish port for redis (container port is always 6379).
REDIS_PUBLISH_PORT=6379

TIME_ZONE=Asia/Qatar

# Device gateway (ZKTeco attendance service). Local dev default.
DEVICE_GATEWAY_BASE_URL=http://localhost:8080
# Shared secret: must match what the gateway is configured with.
# Empty = gateway endpoints accept unauthenticated requests (local dev only).
GATEWAY_SECRET_KEY=local-secret-key

# Base domain for tenant subdomains: tenant "demo" is served at
# demo.localhost (no /etc/hosts entry needed for *.localhost).
BASE_DOMAIN=localhost
DEBUG=True

# Prod HTTPS: set True once https:// works end to end (nginx + certs).
# Local dev stays False.
SECURE_COOKIES=False

# django-q2 workers (don't scale qcluster replicas; raise this instead).
Q2_WORKERS=2

# Host publish ports for nginx (container ports stay 80/443).
NGINX_PORT=8080
NGINX_SSL_PORT=8443

# Sentry error tracking. Empty/unset = Sentry disabled (local dev default).
SENTRY_DSN=

# Rows per page on every paginated list view (list tables, reports).
DEFAULT_PAGE_SIZE=25
